# Configuration locale (développement, Termux). Copier en backend/.env.
FP_ENVIRONMENT=development
FP_DATABASE_URL=postgresql+asyncpg://footprono:footprono@127.0.0.1:5432/footprono
FP_REDIS_URL=redis://127.0.0.1:6379/0
# Obligatoire en production (32 caractères minimum) :
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FP_SECRET_KEY=
FP_CORS_ORIGINS=[]
FP_LOG_LEVEL=INFO
FP_LOG_JSON=true
FP_API_FOOTBALL_KEY=
