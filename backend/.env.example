# Configuration locale (développement, Termux). Copier en backend/.env.
FP_ENVIRONMENT=development
FP_DATABASE_URL=postgresql+asyncpg://footprono:footprono@127.0.0.1:5432/footprono
FP_REDIS_URL=redis://127.0.0.1:6379/0
# Obligatoire en production (32 caractères minimum) :
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
FP_SECRET_KEY=
FP_CORS_ORIGINS=[]
FP_LOG_LEVEL=INFO
FP_LOG_JSON=true
FP_API_FOOTBALL_KEY=
# Requêtes API-Football au plus par fichier téléchargé, et réserve quotidienne
# laissée à d'autres usages (archivage des cotes en direct).
FP_API_FOOTBALL_BUDGET=1500
FP_API_FOOTBALL_MIN_REMAINING=200
# Bookmakers relevés pour les matchs à venir (Pinnacle : référence interne, non affiché).
FP_ODDS_BOOKMAKERS=["1xBet","Bet365","Pinnacle"]
# Archive des fichiers bruts téléchargés (football-data, Understat…).
FP_RAW_DATA_DIR=data/raw
