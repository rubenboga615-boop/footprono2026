# Variables du déploiement serveur (docker compose). install-server.sh crée
# deploy/.env à partir de ce fichier et génère les mots de passe.
# Adresse publique (sous-domaine DuckDNS pointant vers l'IP du serveur).
FP_DOMAIN=footprono.duckdns.org
# Version web servie à la même adresse : aucune autre origine autorisée.
FP_CORS_ORIGINS=[]
# Générés par install-server.sh (ne jamais les changer ensuite : la clé
# déconnecterait tous les utilisateurs, le mot de passe bloquerait la base).
FP_SECRET_KEY=
POSTGRES_USER=footprono
POSTGRES_PASSWORD=
POSTGRES_DB=footprono
# Clé API-Football (même valeur que dans backend/.env sur Termux).
FP_API_FOOTBALL_KEY=
# Notifications push : clé du compte de service copiée dans deploy/secrets/.
FP_FCM_CREDENTIALS_FILE=
# Paiement Mobile Money : espace marchand CinetPay → Intégrations (APIKEY, SITE ID).
# Vides : paiement indisponible, Premium activé par l'administrateur.
FP_CINETPAY_API_KEY=
FP_CINETPAY_SITE_ID=
FP_LOG_LEVEL=INFO
# Sauvegardes quotidiennes (heure UTC) gardées ce nombre de jours.
FP_BACKUP_HOUR=3
FP_BACKUP_KEEP_DAYS=14

# Politique de confidentialité (https://<domaine>/confidentialite) : raison sociale
# (après immatriculation au CEPICI) et adresse e-mail de contact pour les données.
FP_LEGAL_NAME="FootProno SARLU, Gagnoa, Côte d'Ivoire"
FP_CONTACT_EMAIL=
