# Reverse proxy HTTPS (certificat Let's Encrypt automatique pour FP_DOMAIN).
{$FP_DOMAIN} {
	encode zstd gzip

	# Les métriques ne sont jamais exposées publiquement. Dans un « handle » : Caddy trie
	# « respond » après « handle », et « respond @metrics 404 » n'était jamais atteint
	# (audit de sécurité du 12/11/2026, /metrics public). Les « handle » avec un chemin
	# passent avant le « handle » général.
	handle /metrics* {
		respond 404
	}

	# Connexion Google de la version web : les pages de connexion de Firebase sont
	# servies sous notre domaine (authDomain), sinon Safari sur iPhone perd la
	# session pendant la redirection vers Google.
	@firebase path /__/auth/* /__/firebase/*
	handle @firebase {
		reverse_proxy https://footprono-56616.firebaseapp.com {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy api:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Pas d'affichage dans le cadre d'un autre site (page piégée) ; la console garde
		# son propre « DENY » (en-tête de l'API, gardé grâce au « ? »).
		?X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Content-Security-Policy : posée par l'API (version web /app/, console /admin/).
		-Server
	}
}
