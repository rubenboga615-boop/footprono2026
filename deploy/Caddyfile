# Reverse proxy HTTPS (certificat Let's Encrypt automatique pour FP_DOMAIN).
{$FP_DOMAIN} {
	encode zstd gzip

	# Les métriques ne sont jamais exposées publiquement.
	@metrics path /metrics
	respond @metrics 404

	# Connexion Google de la version web : les pages de connexion de Firebase sont
	# servies sous notre domaine (authDomain), sinon Safari sur iPhone perd la
	# session pendant la redirection vers Google.
	@firebase path /__/auth/* /__/firebase/*
	handle @firebase {
		reverse_proxy https://footprono-56616.firebaseapp.com {
			header_up Host {upstream_hostport}
		}
	}

	handle {
		reverse_proxy api:8000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
